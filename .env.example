# Copy this file to .env and set real secrets before running containers.
# Do not commit .env.

# Runtime mode
APP_ENV=prod
APP_DEBUG=false

# Database (required outside dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=foodtruck
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-strong-db-password@db:5432/foodtruck

# Auth (required outside dev)
# Minimum recommended length: 32 chars
JWT_SECRET_KEY=replace-with-random-32-plus-char-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo seed credentials (used only with --profile dev)
DEMO_ADMIN_EMAIL=platform@demo.com
DEMO_DEFAULT_PASSWORD=Pass1234!
